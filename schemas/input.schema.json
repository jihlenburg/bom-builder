{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihlenburg/bom-builder/schemas/input.schema.json",
  "title": "BOM Builder design input",
  "description": "One design document: a single design object, an array of designs, or a {\"designs\": [...]} wrapper. Every form is validated strictly; unknown fields are rejected.",
  "oneOf": [
    {"$ref": "#/$defs/design"},
    {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/design"}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["designs"],
      "properties": {
        "designs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/design"}
        }
      }
    }
  ],
  "$defs": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "parts"],
      "properties": {
        "design": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part_number", "manufacturer", "quantity"],
            "properties": {
              "part_number": {"type": "string", "minLength": 1},
              "manufacturer": {"type": "string", "minLength": 1},
              "quantity": {"type": "integer", "minimum": 1},
              "reference": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "package": {"type": ["string", "null"]},
              "pins": {"type": ["integer", "null"], "minimum": 1},
              "designators": {
                "type": ["array", "null"],
                "items": {"type": "string", "minLength": 1}
              },
              "value": {"type": ["string", "null"]},
              "mounted": {"type": ["boolean", "null"]},
              "comment": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
