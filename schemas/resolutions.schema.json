{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihlenburg/bom-builder/schemas/resolutions.schema.json",
  "title": "BOM Builder resolution approval request",
  "description": "One human-approved resolution of an original demand to a replacement part. The approving person is recorded by name: BOM Builder never clears engineering review on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manufacturer", "part_number", "replacement", "approved_by"],
  "properties": {
    "manufacturer": {
      "description": "Manufacturer of the original demand being resolved.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "part_number": {
      "description": "Original demand part number being resolved.",
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "replacement": {"$ref": "#/$defs/replacement"},
    "approved_by": {
      "description": "Name of the person who cleared engineering review.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "note": {
      "description": "Optional free-form approval context.",
      "type": "string",
      "maxLength": 500
    },
    "source_documents": {
      "description": "Fetched documents backing the approval, identified by URL and content hash.",
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/evidenceDocument"}
    }
  },
  "$defs": {
    "replacement": {
      "description": "The approved replacement part, optionally pinned to one provider-orderable SKU.",
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "part_number"],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "part_number": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "provider": {
          "enum": ["mouser", "digikey", "ti", "farnell", "nxp", "microchip"]
        },
        "provider_sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "dependentRequired": {
        "provider_sku": ["provider"]
      }
    },
    "evidenceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
