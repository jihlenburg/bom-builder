{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihlenburg/bom-builder/schemas/output.schema.json",
  "title": "BOM Builder command output envelope",
  "type": "object",
  "required": ["schema_version", "status", "exit_code"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"type": "string"},
    "exit_code": {"enum": [0, 2, 3, 4, 5]},
    "command": {"type": "string"},
    "version": {"type": "string"},
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "started_at",
        "duration_ms",
        "providers",
        "request_count"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "request_count"],
            "properties": {
              "name": {"enum": ["mouser", "digikey", "ti", "nxp"]},
              "request_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "request_count": {"type": "integer", "minimum": 0},
        "cache": {"$ref": "#/$defs/cacheRun"}
      }
    },
    "units": {"type": "integer", "minimum": 1},
    "attrition": {"$ref": "#/$defs/decimal"},
    "kind": {"enum": ["resistor", "capacitor", "inductor"]},
    "required_quantity": {"type": "integer", "minimum": 1},
    "original": {"type": "object"},
    "original_sourcing": {"$ref": "#/$defs/sourcedPart"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/alternativeResult"}
    },
    "query": {"$ref": "#/$defs/demand"},
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/documentLink"}
    },
    "artifact": {
      "oneOf": [
        {"$ref": "#/$defs/documentArtifact"},
        {"$ref": "#/$defs/exportArtifact"}
      ]
    },
    "cache": {"type": "object"},
    "entries": {"type": "array"},
    "verification": {"type": "object"},
    "prune": {"type": "object"},
    "summary": {
      "type": "object",
      "properties": {
        "line_count": {"type": "integer", "minimum": 0},
        "priced_count": {"type": "integer", "minimum": 0},
        "shortage_count": {"type": "integer", "minimum": 0},
        "review_count": {"type": "integer", "minimum": 0},
        "not_found_count": {"type": "integer", "minimum": 0},
        "not_applicable_count": {"type": "integer", "minimum": 0},
        "provider_error_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "compatible_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0},
        "incompatible_count": {"type": "integer", "minimum": 0},
        "sourced_count": {"type": "integer", "minimum": 0},
        "in_stock_count": {"type": "integer", "minimum": 0},
        "recommended_for_review_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "total_cost": {"$ref": "#/$defs/decimal"},
        "cost_per_unit": {"$ref": "#/$defs/decimal"}
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["demand", "status", "candidate_count"],
        "properties": {
          "demand": {"$ref": "#/$defs/demand"},
          "status": {
            "enum": [
              "priced",
              "shortage",
              "stock_unknown",
              "unavailable",
              "review",
              "not_found",
              "not_applicable",
              "provider_error"
            ]
          },
          "candidate_count": {"type": "integer", "minimum": 0},
          "issue_code": {"type": "string"},
          "issue_message": {"type": "string"},
          "offer": {"$ref": "#/$defs/offer"},
          "offers": {
            "type": "array",
            "items": {"$ref": "#/$defs/offer"}
          },
          "resolution": {"$ref": "#/$defs/appliedResolution"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "cacheRun": {
      "type": "object",
      "required": [
        "policy",
        "hits",
        "stale_hits",
        "misses",
        "refreshes",
        "writes",
        "bypasses",
        "error_count",
        "reused_source_requests"
      ],
      "properties": {
        "policy": {"enum": ["prefer", "refresh", "only", "offline", "off"]},
        "hits": {"type": "integer", "minimum": 0},
        "stale_hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "refreshes": {"type": "integer", "minimum": 0},
        "writes": {"type": "integer", "minimum": 0},
        "bypasses": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "reused_source_requests": {"type": "integer", "minimum": 0}
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{6}$"
    },
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "demand": {
      "type": "object",
      "required": [
        "part_number",
        "manufacturer",
        "quantity_per_unit",
        "required_quantity"
      ],
      "properties": {
        "part_number": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string", "minLength": 1},
        "quantity_per_unit": {"type": "integer", "minimum": 1},
        "required_quantity": {"type": "integer", "minimum": 1}
      }
    },
    "documentLink": {
      "type": "object",
      "required": [
        "kind",
        "provider",
        "url",
        "preferred",
        "downloadable"
      ],
      "properties": {
        "kind": {"enum": ["datasheet", "product_page"]},
        "provider": {"enum": ["mouser", "digikey", "ti", "nxp"]},
        "url": {"type": "string", "format": "uri"},
        "manufacturer_part_number": {"type": "string"},
        "preferred": {"type": "boolean"},
        "downloadable": {"type": "boolean"}
      }
    },
    "documentArtifact": {
      "type": "object",
      "required": [
        "source_url",
        "final_url",
        "output_path",
        "mime_type",
        "size_bytes",
        "sha256",
        "fetched_at"
      ],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "final_url": {"type": "string", "format": "uri"},
        "output_path": {"type": "string", "minLength": 1},
        "mime_type": {"const": "application/pdf"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fetched_at": {"type": "string", "format": "date-time"}
      }
    },
    "exportArtifact": {
      "type": "object",
      "required": [
        "output_path",
        "format",
        "size_bytes",
        "sha256",
        "line_count"
      ],
      "properties": {
        "output_path": {"type": "string", "minLength": 1},
        "format": {"enum": ["ec-bom-csv"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "line_count": {"type": "integer", "minimum": 1}
      }
    },
    "fieldComparison": {
      "type": "object",
      "required": [
        "field",
        "requirement",
        "original_value",
        "candidate_value",
        "relation"
      ],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "requirement": {
          "enum": [
            "equal",
            "candidate_lte",
            "candidate_gte",
            "candidate_superset"
          ]
        },
        "original_value": {"type": ["string", "null"]},
        "candidate_value": {"type": ["string", "null"]},
        "relation": {"enum": ["equal", "better", "worse", "unknown"]}
      }
    },
    "alternativeResult": {
      "type": "object",
      "required": [
        "candidate",
        "compatibility",
        "engineering_review_required",
        "evidence_document_count",
        "comparisons",
        "rejected_reasons",
        "recommended_for_review"
      ],
      "properties": {
        "candidate": {"type": "object"},
        "compatibility": {
          "enum": ["compatible", "unknown", "incompatible"]
        },
        "engineering_review_required": {"const": true},
        "evidence_document_count": {"type": "integer", "minimum": 0},
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fieldComparison"}
        },
        "rejected_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "sourcing": {"$ref": "#/$defs/sourcedPart"},
        "rank": {"type": "integer", "minimum": 1},
        "recommended_for_review": {"type": "boolean"}
      }
    },
    "sourcedPart": {
      "type": "object",
      "required": ["demand", "status", "offers", "candidate_count"],
      "properties": {
        "demand": {"$ref": "#/$defs/demand"},
        "status": {
          "enum": [
            "priced",
            "shortage",
            "stock_unknown",
            "unavailable",
            "review",
            "not_found",
            "not_applicable",
            "provider_error"
          ]
        },
        "selected_provider": {
          "enum": ["mouser", "digikey", "ti", "nxp"]
        },
        "selected_distributor_part_number": {"type": "string"},
        "offer": {"$ref": "#/$defs/offer"},
        "offers": {
          "type": "array",
          "items": {"$ref": "#/$defs/offer"}
        },
        "candidate_count": {"type": "integer", "minimum": 0},
        "issue_code": {"type": "string"},
        "issue_message": {"type": "string"},
        "resolution": {"$ref": "#/$defs/appliedResolution"}
      }
    },
    "appliedResolution": {
      "description": "Provenance of a stored human approval that redirected this demand to its approved replacement. review_lifted is true only when the human pinned the exact provider SKU that came back review-required with verified covering stock.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "approved_by",
        "approved_at",
        "original_manufacturer",
        "original_part_number",
        "replacement_manufacturer",
        "replacement_part_number",
        "review_lifted"
      ],
      "properties": {
        "resolution_id": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string"},
        "original_manufacturer": {"type": "string"},
        "original_part_number": {"type": "string"},
        "replacement_manufacturer": {"type": "string"},
        "replacement_part_number": {"type": "string"},
        "provider": {
          "enum": ["mouser", "digikey", "ti", "nxp", "microchip"]
        },
        "provider_sku": {"type": "string"},
        "review_lifted": {"type": "boolean"}
      }
    },
    "offer": {
      "type": "object",
      "required": [
        "provider",
        "match_method",
        "review_required",
        "required_quantity"
      ],
      "properties": {
        "provider": {"enum": ["mouser", "digikey", "ti", "nxp"]},
        "distributor_part_number": {"type": "string"},
        "manufacturer_part_number": {"type": "string"},
        "manufacturer": {"type": "string"},
        "description": {"type": "string"},
        "category": {"type": "string"},
        "match_method": {"enum": ["exact", "candidate"]},
        "review_required": {"type": "boolean"},
        "required_quantity": {"type": "integer", "minimum": 1},
        "available_quantity": {"type": "integer", "minimum": 0},
        "availability": {"type": "string"},
        "lead_time": {"type": "string"},
        "lifecycle_status": {"type": "string"},
        "packaging": {"type": "string"},
        "minimum_order_quantity": {"type": "integer", "minimum": 0},
        "order_multiple": {"type": "integer", "minimum": 0},
        "standard_pack_quantity": {"type": "integer", "minimum": 0},
        "order_limit": {"type": "integer", "minimum": 0},
        "datasheet_url": {"type": "string", "format": "uri"},
        "product_url": {"type": "string", "format": "uri"},
        "price_breaks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quantity", "unit_price", "currency"],
            "properties": {
              "quantity": {"type": "integer", "minimum": 1},
              "unit_price": {"$ref": "#/$defs/decimal"},
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
            }
          }
        },
        "selected_plan": {"$ref": "#/$defs/purchasePlan"},
        "candidate_plan": {"$ref": "#/$defs/purchasePlan"}
      }
    },
    "purchasePlan": {
      "type": "object",
      "required": [
        "required_quantity",
        "purchased_quantity",
        "surplus_quantity",
        "effective_unit_price",
        "extended_price",
        "currency",
        "pricing_strategy",
        "order_plan",
        "stock_verified",
        "legs"
      ],
      "properties": {
        "required_quantity": {"type": "integer", "minimum": 1},
        "purchased_quantity": {"type": "integer", "minimum": 1},
        "surplus_quantity": {"type": "integer", "minimum": 0},
        "effective_unit_price": {"$ref": "#/$defs/decimal"},
        "extended_price": {"$ref": "#/$defs/decimal"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "pricing_strategy": {"type": "string", "minLength": 1},
        "order_plan": {"type": "string", "minLength": 1},
        "stock_verified": {"type": "boolean"},
        "legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "family_id",
              "purchased_quantity",
              "unit_price",
              "extended_price",
              "currency",
              "stock_verified"
            ],
            "properties": {
              "family_id": {"type": "string", "minLength": 1},
              "purchased_quantity": {"type": "integer", "minimum": 1},
              "unit_price": {"$ref": "#/$defs/decimal"},
              "extended_price": {"$ref": "#/$defs/decimal"},
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "minimum_order_quantity": {"type": "integer", "minimum": 0},
              "order_multiple": {"type": "integer", "minimum": 0},
              "marketplace": {"type": "boolean"},
              "stock_verified": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
