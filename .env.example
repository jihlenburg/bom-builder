# BOM Builder configuration. Copy to .env and fill in credentials.
# Inherited process environment variables always override this file, and
# .env parsing never evaluates shell syntax.

# Mouser. MOUSER_API_KEYS rotates through a comma-separated key list;
# MOUSER_API_KEY is the single-key fallback.
MOUSER_API_KEY=your-mouser-api-key
MOUSER_API_KEYS=your-primary-mouser-api-key,your-backup-mouser-api-key
BOM_BUILDER_MOUSER_MAX_ATTEMPTS=3

# Digi-Key. The account ID is required by Product Information V4 with
# two-legged OAuth.
DIGIKEY_CLIENT_ID=your-digikey-client-id
DIGIKEY_CLIENT_SECRET=your-digikey-client-secret
DIGIKEY_ACCOUNT_ID=your-digikey-account-id
DIGIKEY_LOCALE_SITE=DE
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=EUR
DIGIKEY_LOCALE_SHIP_TO_COUNTRY=de
BOM_BUILDER_DIGIKEY_MAX_ATTEMPTS=3

# TI Store.
TI_STORE_API_KEY=your-ti-store-api-key
TI_STORE_API_SECRET=your-ti-store-api-secret
TI_STORE_PRICE_CURRENCY=USD
BOM_BUILDER_TI_MAX_ATTEMPTS=3

# Farnell / element14. The regional store implies the price currency
# (de.farnell.com quotes EUR), so FARNELL_PRICE_CURRENCY is needed only
# for a store the adapter does not know.
FARNELL_API_KEY=your-farnell-api-key
FARNELL_STORE_ID=de.farnell.com
FARNELL_PRICE_CURRENCY=
BOM_BUILDER_FARNELL_MAX_ATTEMPTS=3

# Optional integrations. The Microchip Product API and the ECB currency
# quotes need no credentials.
OPENAI_API_KEY=your-openai-api-key

# Lookup-cache behavior. Policies: prefer, refresh, only, offline, off.
BOM_BUILDER_CACHE_POLICY=prefer
BOM_BUILDER_CACHE_TTL=24h

# Trusted-path and endpoint overrides (BOM_BUILDER_CACHE_DB,
# BOM_BUILDER_RESOLUTIONS_DB, BOM_BUILDER_ECB_URL, and the per-provider
# *_URL overrides) are deliberately refused from .env: a checkout-local
# file must not be able to redirect authenticated traffic or relocate
# trusted state. Export them in the process environment instead.
